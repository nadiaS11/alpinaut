---
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 py-12 bg-night-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <div class="flex items-center gap-2.5 text-white font-semibold">
          <img
            src="/alpinaut-icon.svg"
            alt=""
            width="28"
            height="28"
            class="w-7 h-7 rounded-md"
            decoding="async"
          />
          Alpinaut
        </div>
        <p class="mt-2 text-sm text-slate-500">
          Built with <span class="text-slate-300">Astro</span> + <span class="text-slate-300">Alpine</span>. Zero React. Zero Vue. Zero Svelte.
        </p>
      </div>

      <ul class="flex items-center gap-5 text-slate-400">
        <li>
          <a href="https://twitter.com/" rel="me noreferrer" class="hover:text-white" aria-label="Alpinaut on X (placeholder)">
            <!-- X -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21l-6.52 7.452L22.5 22h-6.86l-4.7-6.13L5.46 22H2.7l6.98-7.978L1.5 2h7.04l4.246 5.612L18.244 2Zm-1.2 18h1.91L7.06 4H5.04l12.004 16Z"/></svg>
          </a>
        </li>
        <li>
          <a href="https://bsky.app/" rel="me noreferrer" class="hover:text-white" aria-label="Alpinaut on Bluesky (placeholder)">
            <!-- Bluesky butterfly-ish -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4c2.6.6 5 3.2 6 6 1-2.8 3.4-5.4 6-6 2 0 3 1.8 3 3.6 0 3-2.2 7.4-5 9.4 1.6.2 3.4 1 3.4 3.1 0 2.5-2.6 3.6-4.7 2.6C13 21.8 12.4 20.6 12 19c-.4 1.6-1 2.8-2.7 3.7-2.1 1-4.7-.1-4.7-2.6 0-2.1 1.8-2.9 3.4-3.1C5.2 15 3 10.6 3 7.6 3 5.8 4 4 6 4Z"/></svg>
          </a>
        </li>
        <li>
          <a href="https://github.com/" rel="me noreferrer" class="hover:text-white" aria-label="Alpinaut on GitHub (placeholder)">
            <!-- GitHub -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2.9-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.6 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-8 pt-6 border-t border-white/5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs text-slate-500">
      <p>© {year} Alpinaut. Bring your own opinions.</p>
      <p>
        Unsubscribes are handled by Buttondown — every email has a one-click link at the bottom.
      </p>
    </div>
  </div>
</footer>

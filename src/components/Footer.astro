---
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 py-12 bg-night-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <div class="flex items-center gap-2.5 text-white font-semibold">
          <img
            src="/alpinaut-icon.svg"
            alt=""
            width="28"
            height="28"
            class="w-7 h-7 rounded-md"
            decoding="async"
          />
          Alpinaut
        </div>
        <p class="mt-2 text-sm text-slate-500">
          Built with <span class="text-slate-300">Astro</span> + <span class="text-slate-300">Alpine</span>. Zero React. Zero Framework JS.
        </p>
      </div>

   <!-- <Socials/> -->
    </div>

    <div class="mt-8 pt-6 border-t border-white/5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs text-slate-500">
      <p>© {year} Alpinaut. Bring your own opinions.</p>
      <p>
        Unsubscribes are handled by Buttondown — every email has a one-click link at the bottom.
      </p>
    </div>
  </div>
</footer>

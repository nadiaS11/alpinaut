const testimonials = [
  {
    quote: "Finally a newsletter that respects my LCP. The Pattern of the Week alone is worth the inbox slot.",
    name: 'TODO — placeholder',
    handle: '@abuhanifpappo',
    role: 'Editor, Lumero Media',
  },
  {
    quote: "I rewrote our marketing site from Next.js to Astro + Alpine after issue #4. Bundle went from 380 KB to 9 KB.",
    name: 'TODO — placeholder',
    handle: '@nadiasultana',
    role: 'Frohtend Developer, Evatix',
  },
  {

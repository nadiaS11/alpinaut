---
import SignupForm from './SignupForm.astro';
---

<section class="relative py-24 sm:py-28 border-t border-white/5">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
      One email. One Wednesday. <span class="text-ridge-400">Zero React.</span>
    </h2>
    <p class="mt-4 text-slate-300 text-lg">
      Join the Alpinauts. Bring a sense of humor and a Lighthouse tab.
    </p>
    <div class="mt-8">
      <SignupForm id="cta-signup" variant="cta" />
    </div>
  </div>
</section>

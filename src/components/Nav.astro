---
// Sticky nav with a mobile hamburger powered by Alpine. The whole thing is
// a single x-data island — total client JS for this component is a couple of
// boolean toggles.
---

<header
  class="sticky top-0 z-40 backdrop-blur-md bg-night-950/70 border-b border-white/5 [&.scrolled]:border-b-aurora-400 "
  x-data="{ open: false }"
  x-bind:class="{ scrolled: scrolled }"
  @keydown.escape.window="open = false"
>
  <nav
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="flex items-center font-semibold tracking-tight text-white"
      aria-label="Alpinaut — home"
    >
      <!-- Wordmark SVG already contains the mark + "alpinaut." lettering -->
      <img
        src="/alpinaut-wordmark.svg"
        alt="Alpinaut"
        class="w-auto h-16"
        decoding="async"
      />
    </a>

    <ul class="hidden md:flex items-center gap-8 text-sm text-slate-300">
      <li><a class="hover:text-white transition" href="#why">Why</a></li>
      <li>
        <a class="hover:text-white transition" href="#weekly">What you get</a>
      </li>
      <li><a class="hover:text-white transition" href="#faq">FAQ</a></li>
    </ul>

    <a
      href="#signup"
      class="hidden md:inline-flex btn-primary px-4 py-2 rounded-md text-sm"
    >
      Subscribe
    </a>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-md text-slate-200 hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cosmos-400"
      aria-label="Toggle menu"
      :aria-expanded="open.toString()"
      aria-controls="mobile-menu"
      @click="open = !open"
    >
      <svg
        x-show="!open"
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        x-show="open"
        x-cloak
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden border-t border-white/5 bg-night-900/95"
    x-show="open"
    x-cloak
    x-transition.opacity
  >
    <ul class="px-4 py-4 space-y-2 text-base">
      <li>
        <a
          class="block py-2 text-slate-200 hover:text-white"
          href="#why"
          @click="open = false">Why</a>
      </li>
      <li>
        <a
          class="block py-2 text-slate-200 hover:text-white"
          href="#weekly"
          @click="open = false">What you get</a>
      </li>
      <li>
        <a
          class="block py-2 text-slate-200 hover:text-white"
          href="#faq"
          @click="open = false">FAQ</a>
      </li>
      <li class="pt-2">
        <a
          href="#signup"
          class="btn-primary inline-flex w-full justify-center px-4 py-2.5 rounded-md"
          @click="open = false"
        >
          Subscribe
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

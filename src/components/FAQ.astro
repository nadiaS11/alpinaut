---
// Using native <details>/<summary> — zero JS, fully accessible, keyboard
// navigable, and lighter than any Alpine accordion implementation.
const faqs = [
  {
    q: 'What is Alpinaut, exactly?',
    a: "A weekly email newsletter about building production websites with Astro and Alpine.js. Opinions, links, and a copy-pasteable pattern. No course funnel.",
  },
  {
    q: 'How often does it ship?',
    a: 'Every Wednesday. If a week is slow, you get a shorter issue rather than padding.',
  },
  {
    q: 'Is it free?',
    a: "Yes. There is no paid tier planned. Sponsor slots may appear occasionally — clearly labelled, never disguised as content.",
  },
  {
    q: "Who's it for?",
    a: "Developers who are already past the \"why not React?\" debate and want to get better at the Astro + Alpine sweet spot. Both newcomers and people who shipped their first Astro site in 2022 are welcome.",
  },
  {
    q: 'Do I need to know Alpine.js already?',
    a: "Nope. If you can write a bit of HTML and JavaScript, you can read every issue. Patterns are introduced with context, not jargon.",
  },
];
---

<section id="faq" class="relative py-24 sm:py-32 border-t border-white/5">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-sm font-mono text-ridge-400 uppercase tracking-widest">// FAQ</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-white tracking-tight">
        The reasonable questions
      </h2>
    </div>

    <div class="mt-12 space-y-3">
      {faqs.map((item) => (
        <details class="card rounded-xl overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 px-5 py-4 text-white font-medium hover:bg-white/[0.02] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cosmos-400">
            <span>{item.q}</span>
            <svg class="chev w-5 h-5 text-slate-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="px-5 pb-5 -mt-1 text-slate-300 leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
